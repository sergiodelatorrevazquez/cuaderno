---
import '../styles/global.css';
import { SITE, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · Apuntes del MUII`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101014" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />

    <script is:inline>
      (function () {
        try {
          var guardado = localStorage.getItem('tema');
          var oscuro = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = guardado || (oscuro ? 'dark' : 'light');
        } catch (error) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url('/')}>
          <span class="brand-mark" aria-hidden="true">C</span>
          <span class="brand-text">Cuaderno <strong>MUII</strong></span>
        </a>

        <nav class="site-nav" aria-label="Navegación principal">
          <a href={url('/')}>Inicio</a>
          <a href={url('/#asignaturas')}>Asignaturas</a>
        </nav>

        <button
          class="theme-toggle"
          id="theme-toggle"
          type="button"
          aria-label="Cambiar entre tema claro y oscuro"
          title="Cambiar tema"
        >
          <svg
            class="icon-moon"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <svg
            class="icon-sun"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="contenido" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>Cuaderno de apuntes del MUII · Universidad de Málaga</p>
        <p class="muted">
          {new Date().getFullYear()} · Hecho con <a href="https://astro.build" target="_blank" rel="noreferrer">Astro</a>
        </p>
      </div>
    </footer>

    <script>
      const botonTema = document.getElementById('theme-toggle');

      botonTema?.addEventListener('click', () => {
        const actual = document.documentElement.dataset.theme;
        const siguiente = actual === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = siguiente;
        try {
          localStorage.setItem('tema', siguiente);
        } catch (error) {
          /* sin persistencia */
        }
      });

      // Las listas de tareas de Markdown generan checkboxes sin etiqueta.
      document.querySelectorAll<HTMLInputElement>('.prose input[type="checkbox"]').forEach((checkbox) => {
        checkbox.setAttribute(
          'aria-label',
          checkbox.checked ? 'Tarea completada' : 'Tarea pendiente',
        );
      });
    </script>
  </body>
</html>
