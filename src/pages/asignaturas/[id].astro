---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/site';
import { formatDate, ordenarApuntes, pluralizar } from '../../lib/utils';

export async function getStaticPaths() {
  const asignaturas = await getCollection('asignaturas');
  return asignaturas.map((asignatura) => ({
    params: { id: asignatura.id },
    props: { asignatura },
  }));
}

interface Props {
  asignatura: CollectionEntry<'asignaturas'>;
}

const { asignatura } = Astro.props;

const apuntes = ordenarApuntes(
  await getCollection('apuntes', ({ data }) => data.asignatura.id === asignatura.id),
);
---

<BaseLayout
  title={asignatura.data.nombre}
  description={`${asignatura.data.nombre} · Cuaderno MUII`}
>
  <nav class="breadcrumbs" aria-label="Migas de pan">
    <a href={url('/')}>Inicio</a>
    <span aria-hidden="true">/</span>
    <span>{asignatura.data.nombre}</span>
  </nav>

  <header class="page-header" style={`--page-accent: ${asignatura.data.color}`}>
    <p class="eyebrow">{asignatura.data.curso} · {asignatura.data.semestre}º semestre</p>
    <h1>{asignatura.data.nombre}</h1>
    <p class="muted">{pluralizar(apuntes.length, 'apunte disponible', 'apuntes disponibles')}</p>
  </header>

  {
    apuntes.length === 0 ? (
      <p class="empty">
        Aún no hay apuntes de esta asignatura. Crea un archivo en
        <code>src/content/apuntes/{asignatura.id}/</code>.
      </p>
    ) : (
      <ol class="apuntes-lista">
        {apuntes.map((apunte) => (
          <li>
            <a class="apunte-card" href={url(`/apuntes/${apunte.id}/`)}>
              <span class="apunte-num">{String(apunte.data.orden).padStart(2, '0')}</span>
              <div class="apunte-info">
                <h3>{apunte.data.titulo}</h3>
                <p>
                  {apunte.data.tema && <span class="tema">{apunte.data.tema}</span>}
                  {apunte.data.tema && <span aria-hidden="true"> · </span>}
                  {formatDate(apunte.data.fecha)}
                </p>
              </div>
              <span class="apunte-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</BaseLayout>
