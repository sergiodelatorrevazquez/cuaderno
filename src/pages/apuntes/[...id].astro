---
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/site';
import { formatDate, readingTime } from '../../lib/utils';

export async function getStaticPaths() {
  const apuntes = await getCollection(
    'apuntes',
    ({ data }) => import.meta.env.DEV || !data.borrador,
  );
  return apuntes.map((apunte) => ({
    params: { id: apunte.id },
    props: { apunte },
  }));
}

interface Props {
  apunte: CollectionEntry<'apuntes'>;
}

const { apunte } = Astro.props;

const asignatura = await getEntry(apunte.data.asignatura);
const { Content, headings } = await render(apunte);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const minutos = readingTime(apunte.body);

const relacionados = (
  await getCollection(
    'apuntes',
    ({ data }) =>
      data.asignatura.id === apunte.data.asignatura.id &&
      (import.meta.env.DEV || !data.borrador),
  )
).sort((a, b) => a.data.fecha.getTime() - b.data.fecha.getTime());

const indiceActual = relacionados.findIndex((item) => item.id === apunte.id);
const anterior = indiceActual > 0 ? relacionados[indiceActual - 1] : null;
const siguiente =
  indiceActual >= 0 && indiceActual < relacionados.length - 1
    ? relacionados[indiceActual + 1]
    : null;

const fechaISO = apunte.data.fecha.toISOString().slice(0, 10);
---

<BaseLayout
  title={apunte.data.titulo}
  description={apunte.data.resumen || `Apunte de ${asignatura?.data.nombre ?? 'el MUII'}`}
>
  <nav class="breadcrumbs" aria-label="Migas de pan">
    <a href={url('/')}>Inicio</a>
    <span aria-hidden="true">/</span>
    {
      asignatura ? (
        <a href={url(`/asignaturas/${asignatura.id}/`)}>{asignatura.data.nombre}</a>
      ) : (
        <span>Sin asignatura</span>
      )
    }
    <span aria-hidden="true">/</span>
    <span>{apunte.data.titulo}</span>
  </nav>

  <div class="note-layout">
    <article class="note">
      <header class="note-header">
        {asignatura && (
          <a class="eyebrow" href={url(`/asignaturas/${asignatura.id}/`)}>
            {asignatura.data.nombre}
          </a>
        )}
        <h1>{apunte.data.titulo}</h1>
        {apunte.data.resumen && <p class="lead">{apunte.data.resumen}</p>}

        <div class="note-meta">
          <time datetime={fechaISO}>{formatDate(apunte.data.fecha)}</time>
          <span class="sep" aria-hidden="true">·</span>
          <span>{minutos} min de lectura</span>
          {apunte.data.tema && (
            <>
              <span class="sep" aria-hidden="true">·</span>
              <span>{apunte.data.tema}</span>
            </>
          )}
          {apunte.data.borrador && <span class="borrador">Borrador</span>}
        </div>

        {apunte.data.tags.length > 0 && (
          <ul class="tags" aria-label="Etiquetas">
            {apunte.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}
      </header>

      <div class="prose">
        <Content />
      </div>

      {(anterior || siguiente) && (
        <nav class="note-nav" aria-label="Navegación entre apuntes">
          {
            anterior ? (
              <a href={url(`/apuntes/${anterior.id}/`)}>
                <span class="nav-label">← Anterior</span>
                <span class="nav-title">{anterior.data.titulo}</span>
              </a>
            ) : (
              <span></span>
            )
          }
          {
            siguiente ? (
              <a class="next" href={url(`/apuntes/${siguiente.id}/`)}>
                <span class="nav-label">Siguiente →</span>
                <span class="nav-title">{siguiente.data.titulo}</span>
              </a>
            ) : (
              <span></span>
            )
          }
        </nav>
      )}
    </article>

    {toc.length >= 2 && (
      <aside class="toc" aria-label="En esta página">
        <p class="toc-title">En esta página</p>
        <ol>
          {toc.map((heading) => (
            <li class={`depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </div>
</BaseLayout>
